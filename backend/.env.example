# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y define los valores correspondientes.
# NUNCA incluyas secretos de producción en el repositorio git.
# ==============================================================================

# Entorno de ejecución: 'development' o 'production'
ENVIRONMENT=development

# ==============================================================================
# SEGURIDAD Y AUTENTICACIÓN (Obligatorio en producción)
# ==============================================================================
# Generar SECRET_KEY en consola con:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambiar_por_clave_segura_generada_aleatoriamente

# Clave Fernet para encriptación de datos (32 bytes url-safe base64)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=r4Pn0YDQH7obBlPFuPHzWj_hEWLotrVUHonpkba_fn8=

# ==============================================================================
# BASE DE DATOS POSTGRESQL (Obligatorio en producción)
# ==============================================================================
DATABASE_URL=postgresql://usuario:password@localhost:5432/apupro_db

# ==============================================================================
# URLs Y CORS
# ==============================================================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://www.costbase.net","https://arko360.net"]

# ==============================================================================
# REDIS Y CELERY (Opcional en desarrollo local sin colas)
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================================================
# SERVICIOS DE CORREO Y NOTIFICACIONES
# ==============================================================================
# Resend (Recomendado para transaccional)
RESEND_API_KEY=re_tu_clave_resend_aqui
RESEND_FROM_EMAIL=CostBase <info@costbase.net>

# Fallback SMTP
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password

# ==============================================================================
# OAUTH Y TERCEROS
# ==============================================================================
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Gemini AI
GEMINI_API_KEY=tu_api_key_gemini
